---
import { resolveLink } from "../../lib/links";
const { section } = Astro.props;

function getHref(link: any) {
  if (!link) return "#";

  return link.linkType === "external"
    ? link.externalUrl ?? "#"
    : link.internalPath ?? "#";
}
---

<section class:list={["cta-section", section?.theme ?? "navy"]}>
  <div class="container">
    {section?.eyebrow && (
      <p class="eyebrow">{section.eyebrow}</p>
    )}

    <h2>{section?.heading}</h2>

    {section?.accentText && (
      <p class="accent">{section.accentText}</p>
    )}

    {section?.description && (
      <p class="description">{section.description}</p>
    )}

    {section?.cta?.link && (
      <a href={resolveLink(section.cta.link)}>
        {section.cta.link.label}
        <span>→</span>
      </a>
    )}
  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--section-space-lg);
  }

  .navy {
    background: var(--color-brand-navy);
    color: white;
  }

  .ivory {
    background: var(--color-brand-ivory);
    color: var(--color-brand-charcoal);
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h2 {
    max-width: 1000px;
    margin-top: 1rem;
    font-size: clamp(3.5rem, 8vw, 8rem);
    text-transform: uppercase;
  }

  .accent {
    font-family: var(--font-editorial);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-style: italic;
  }

  .description {
    max-width: 650px;
    margin-top: 1.5rem;
    opacity: 0.7;
  }

  a {
    display: inline-flex;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
</style>