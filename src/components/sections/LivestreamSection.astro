---
import { createImageUrlBuilder } from "@sanity/image-url";
import { sanityClient } from "sanity:client";

const { section } = Astro.props;
const layout = section?.layout ?? "immersive";
const isMediaHub = layout === "mediaHub";

const media = section?.siteMedia;

const liveStreamUrl =
  section?.liveStreamUrl ??
  media?.liveStreamUrl ??
  media?.youtubeChannelUrl;

const imageSource =
  section?.image ??
  media?.liveStreamImage;

const builder = createImageUrlBuilder(sanityClient);

const imageUrl = imageSource?.asset
  ? builder
      .image(imageSource)
      .width(1800)
      .height(1100)
      .fit("crop")
      .auto("format")
      .quality(90)
      .url()
  : null;
---

<section
  class:list={[
    "livestream",
    { "is-media-hub": isMediaHub }
  ]}
>
  <div class="container">

    <div class="heading">
      <div>
        {section?.eyebrow && (
          <p class="eyebrow">{section.eyebrow}</p>
        )}

        {section?.heading && (
          <h2>{section.heading}</h2>
        )}

        {section?.accentText && (
          <p class="accent">
            {section.accentText}
          </p>
        )}
      </div>

      {section?.description && (
        <p class="description">
          {section.description}
        </p>
      )}
    </div>

    <div class="live-card" id="livestream-card">
      {
        imageUrl && (
          <img
            src={imageUrl}
            alt={
              imageSource?.alt ??
              "PIWC Philadelphia livestream"
            }
            loading="lazy"
          />
        )
      }

      <div class="overlay"></div>

      <div class="live-content">
        <div class="live-indicator">
          <span></span>
          ONLINE WORSHIP
        </div>

        <h3>
          WATCH PIWC
          <span>online.</span>
        </h3>

        {
          liveStreamUrl && (
            <a
              href={liveStreamUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {section?.ctaLabel ?? "WATCH LIVE"}
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>

<div
      class="live-player"
      id="live-player"
      hidden
>
    <div class="live-player-header">
      <div class="live-now">
        <span class="live-dot"></span>
        LIVE NOW
      </div>

      <p id="live-title"></p>
    </div>

    <div class="video-wrapper">
      <iframe
        id="live-iframe"
        title="PIWC Philadelphia Live"
        src=""
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <a
      id="youtube-live-link"
      class="youtube-live-link"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
    >
      WATCH ON YOUTUBE
      <span aria-hidden="true">↗</span>
    </a>
</div>

  </div>
</section>

<script>
  async function checkLivestream() {
    const offlineCard =
      document.getElementById("livestream-card");

    const livePlayer =
      document.getElementById("live-player");

    const iframe =
      document.getElementById("live-iframe") as HTMLIFrameElement | null;

    const title =
      document.getElementById("live-title");

    const youtubeLink =
      document.getElementById("youtube-live-link") as HTMLAnchorElement | null;

    if (
      !offlineCard ||
      !livePlayer ||
      !iframe ||
      !youtubeLink
    ) {
      return;
    }

    try {
      const response = await fetch("/api/youtube-live");

      if (!response.ok) {
        return;
      }

      const data = await response.json();

      if (!data.isLive || !data.videoId) {
        return;
      }

      iframe.src =
        `https://www.youtube.com/embed/${data.videoId}`;

      youtubeLink.href =
        data.watchUrl ??
        `https://www.youtube.com/watch?v=${data.videoId}`;

      if (title && data.title) {
        title.textContent = data.title;
      }

      offlineCard.hidden = true;
      livePlayer.hidden = false;
    } catch (error) {
      console.error(
        "Unable to check livestream status:",
        error
      );
    }
  }

  checkLivestream();
</script>

<style>
  .livestream {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-navy);
    color: white;
  }

  .heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 8vw, 9rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
  }

  .accent {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 4rem);
    font-style: italic;
  }

  .description {
    color: rgb(255 255 255 / 65%);
  }

  .live-card {
    position: relative;
    min-height: min(70svh, 760px);
    overflow: hidden;
    background: var(--color-brand-charcoal);
  }

  .live-card > img,
  .overlay {
    position: absolute;
    inset: 0;
  }

  .live-card > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    background:
      linear-gradient(
        0deg,
        rgb(3 14 28 / 85%) 0%,
        rgb(3 14 28 / 20%) 70%
      );
  }

  .live-content {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .live-indicator > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand-gold);
  }

  .live-content h3 {
    margin-top: 1rem;
    max-width: 900px;
    font-size: clamp(3rem, 8vw, 8rem);
    text-transform: uppercase;
  }

  .live-content h3 span {
    display: block;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-style: italic;
    text-transform: none;
  }

  .live-content a {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1rem 1.35rem;
    background: var(--color-brand-gold);
    color: var(--color-brand-navy);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .live-player {
  width: 100%;
}

.live-player[hidden],
.live-card[hidden] {
  display: none;
}

.live-player-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
  margin-bottom: 1.25rem;
}

.live-now {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  color: var(--color-brand-gold);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.live-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #e53935;
  animation: live-pulse 1.5s infinite;
}

#live-title {
  margin: 0;
  color: rgb(255 255 255 / 70%);
  font-size: 0.9rem;
}

.video-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #000;
}

.video-wrapper iframe {
  width: 100%;
  height: 100%;
  border: 0;
}

.youtube-live-link {
  display: inline-flex;
  align-items: center;
  gap: 1rem;
  margin-top: 1.5rem;
  padding: 1rem 1.35rem;
  background: var(--color-brand-gold);
  color: var(--color-brand-navy);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

@keyframes live-pulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.45;
    transform: scale(0.8);
  }
}

  @media (max-width: 800px) {
    .heading {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------------------------
   MEDIA HUB VARIANT
---------------------------------- */

.livestream.is-media-hub {
  padding-block: var(--section-space-md);
}

.is-media-hub .heading {
  grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);
  gap: clamp(2rem, 6vw, 7rem);
  margin-bottom: clamp(3rem, 5vw, 5rem);
}

.is-media-hub .heading h2 {
  max-width: 900px;
  font-size: clamp(3.5rem, 7vw, 7rem);
  line-height: 0.88;
  letter-spacing: -0.045em;
}

.is-media-hub .accent {
  margin-top: 1rem;
  color: var(--color-brand-gold);
  font-size: clamp(1.8rem, 3vw, 3.25rem);
  line-height: 1;
}

.is-media-hub .description {
  max-width: 430px;
  font-size: 1rem;
  line-height: 1.75;
}

/* Compact cinematic card */

.is-media-hub .live-card {
  min-height: auto;
  aspect-ratio: 16 / 7;
}

.is-media-hub .live-card > img {
  transition: transform 900ms ease;
}

.is-media-hub .live-card:hover > img {
  transform: scale(1.02);
}

.is-media-hub .overlay {
  background:
    linear-gradient(
      90deg,
      rgb(3 14 28 / 88%) 0%,
      rgb(3 14 28 / 48%) 45%,
      rgb(3 14 28 / 10%) 78%
    ),
    linear-gradient(
      0deg,
      rgb(3 14 28 / 45%) 0%,
      transparent 55%
    );
}

.is-media-hub .live-content {
  top: 0;
  right: auto;
  display: flex;
  width: min(720px, 70%);
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: clamp(2rem, 5vw, 5rem);
}

.is-media-hub .live-indicator {
  color: var(--color-brand-gold);
}

.is-media-hub .live-content h3 {
  margin-top: 1.25rem;
  font-size: clamp(3rem, 6vw, 6.5rem);
  line-height: 0.85;
  letter-spacing: -0.045em;
}

.is-media-hub .live-content h3 span {
  margin-top: 0.15em;
  color: var(--color-brand-gold);
}

.is-media-hub .live-content a {
  margin-top: clamp(1.75rem, 3vw, 3rem);
  transition:
    transform var(--transition-fast),
    background var(--transition-fast);
}

.is-media-hub .live-content a:hover {
  transform: translateY(-2px);
  background: white;
}

/* When actually live */

.is-media-hub .live-player {
  padding: clamp(1.25rem, 2vw, 2rem);
  background: rgb(255 255 255 / 4%);
  border: 1px solid rgb(255 255 255 / 10%);
}

.is-media-hub .live-player-header {
  margin-bottom: 1.5rem;
}

.is-media-hub .video-wrapper {
  aspect-ratio: 16 / 9;
}

/* Responsive */

@media (max-width: 900px) {
  .is-media-hub .heading {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .is-media-hub .live-card {
    aspect-ratio: 4 / 3;
  }

  .is-media-hub .live-content {
    width: min(760px, 90%);
  }
}

@media (max-width: 600px) {
  .livestream.is-media-hub {
    padding-block: clamp(4.5rem, 15vw, 6rem);
  }

  .is-media-hub .heading h2 {
    font-size: clamp(3rem, 14vw, 4.5rem);
  }

  .is-media-hub .accent {
    font-size: clamp(1.8rem, 8vw, 2.6rem);
  }

  .is-media-hub .live-card {
    min-height: 540px;
    aspect-ratio: auto;
  }

  .is-media-hub .live-card > img {
    object-position: center;
  }

  .is-media-hub .overlay {
    background:
      linear-gradient(
        0deg,
        rgb(3 14 28 / 92%) 0%,
        rgb(3 14 28 / 58%) 55%,
        rgb(3 14 28 / 18%) 100%
      );
  }

  .is-media-hub .live-content {
    top: auto;
    right: 0;
    width: auto;
    justify-content: flex-end;
    padding: 1.75rem;
  }

  .is-media-hub .live-content h3 {
    font-size: clamp(3rem, 15vw, 4.75rem);
  }

  .is-media-hub .live-content a {
    width: 100%;
    justify-content: space-between;
  }

  .is-media-hub .live-player {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .is-media-hub .live-player-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .is-media-hub .live-card > img,
  .is-media-hub .live-content a {
    transition: none;
  }
}
</style>