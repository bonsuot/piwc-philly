---
import imageUrlBuilder from "@sanity/image-url";
import { sanityClient } from "sanity:client";

const { section } = Astro.props;

const media = section?.siteMedia;

const builder = imageUrlBuilder(sanityClient);

const imageSource =
  section?.image?.asset
    ? section.image
    : media?.liveStreamImage;

const imageUrl = imageSource?.asset
  ? builder
      .image(imageSource)
      .width(1800)
      .height(1100)
      .fit("crop")
      .auto("format")
      .quality(90)
      .url()
  : null;
---

<section class="livestream">
  <div class="container">

    <div class="heading">
      <div>
        {section?.eyebrow && (
          <p class="eyebrow">{section.eyebrow}</p>
        )}

        {section?.heading && (
          <h2>{section.heading}</h2>
        )}

        {section?.accentText && (
          <p class="accent">
            {section.accentText}
          </p>
        )}
      </div>

      {section?.description && (
        <p class="description">
          {section.description}
        </p>
      )}
    </div>

    <div class="live-card">
      {
        imageUrl && (
          <img
            src={imageUrl}
            alt={
              imageSource?.alt ??
              "PIWC Philadelphia livestream"
            }
            loading="lazy"
          />
        )
      }

      <div class="overlay"></div>

      <div class="live-content">
        <div class="live-indicator">
          <span></span>
          ONLINE WORSHIP
        </div>

        <h3>
          WATCH PIWC
          <span>online.</span>
        </h3>

        {
          media?.liveStreamUrl && (
            <a
              href={media.liveStreamUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {section?.ctaLabel ?? "WATCH LIVE"}
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>

  </div>
</section>

<style>
  .livestream {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-navy);
    color: white;
  }

  .heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 8vw, 9rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
  }

  .accent {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 4rem);
    font-style: italic;
  }

  .description {
    color: rgb(255 255 255 / 65%);
  }

  .live-card {
    position: relative;
    min-height: min(70svh, 760px);
    overflow: hidden;
    background: var(--color-brand-charcoal);
  }

  .live-card > img,
  .overlay {
    position: absolute;
    inset: 0;
  }

  .live-card > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    background:
      linear-gradient(
        0deg,
        rgb(3 14 28 / 85%) 0%,
        rgb(3 14 28 / 20%) 70%
      );
  }

  .live-content {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    padding: clamp(2rem, 5vw, 5rem);
  }

  .live-indicator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .live-indicator > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand-gold);
  }

  .live-content h3 {
    margin-top: 1rem;
    max-width: 900px;
    font-size: clamp(3rem, 8vw, 8rem);
    text-transform: uppercase;
  }

  .live-content h3 span {
    display: block;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-style: italic;
    text-transform: none;
  }

  .live-content a {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1rem 1.35rem;
    background: var(--color-brand-gold);
    color: var(--color-brand-navy);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  @media (max-width: 800px) {
    .heading {
      grid-template-columns: 1fr;
    }
  }
</style>