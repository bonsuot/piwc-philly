---
import imageUrlBuilder from "@sanity/image-url";
import { sanityClient } from "sanity:client";

const { section } = Astro.props;

const builder = imageUrlBuilder(sanityClient);

function imageUrl(image: any) {
  if (!image?.asset) return "";

  return builder
    .image(image)
    .width(1000)
    .height(1250)
    .fit("crop")
    .auto("format")
    .quality(88)
    .url();
}

let people = [];

switch (section?.selectionMode) {
  case "manual":
    people = section?.people ?? [];
    break;

  case "all":
    people = section?.allPeople ?? [];
    break;

  default:
    people = section?.featuredPeople ?? [];
}

if (
  section?.selectionMode !== "manual" &&
  section?.category &&
  section.category !== "all"
) {
  people = people.filter(
    (person: any) =>
      person.category === section.category
  );
}
---

<section class="people-section">
  <div class="container">

    <div class="section-heading">
      <div>
        {section?.eyebrow && (
          <p class="eyebrow">{section.eyebrow}</p>
        )}

        {section?.heading && (
          <h2>{section.heading}</h2>
        )}

        {section?.accentText && (
          <p class="accent">{section.accentText}</p>
        )}
      </div>

      {section?.description && (
        <p class="intro">
          {section.description}
        </p>
      )}
    </div>

    <div class="people-grid">
      {people.map((person: any) => (
        <article class="person-card">
          <div class="photo">
            <img
              src={imageUrl(person.photo)}
              alt={person.photo?.alt ?? person.name}
              loading="lazy"
            />
          </div>

          <div class="person-info">
            <h3>{person.name}</h3>

            {person.role && (
              <p class="role">{person.role}</p>
            )}

            {person.shortBio && (
              <p class="bio">{person.shortBio}</p>
            )}

            {person.email && (
              <a href={`mailto:${person.email}`}>
                CONNECT →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .people-section {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-ivory);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 8vw, 9rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
  }

  .accent {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 4rem);
    font-style: italic;
  }

  .intro {
    color: var(--color-text-muted);
  }

  .people-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .photo {
    overflow: hidden;
    background: var(--color-brand-stone);
  }

  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .person-card:hover .photo img {
    transform: scale(1.025);
  }

  .person-info {
    padding-top: 1.25rem;
  }

  .person-info h3 {
    font-size: clamp(1.7rem, 3vw, 2.7rem);
    text-transform: uppercase;
  }

  .role {
    margin-top: 0.35rem;
    color: var(--color-brand-gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bio {
    margin-top: 1rem;
    color: var(--color-text-muted);
  }

  .person-info a {
    display: inline-block;
    margin-top: 1rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.7rem;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .section-heading {
      grid-template-columns: 1fr;
    }

    .people-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .people-grid {
      grid-template-columns: 1fr;
    }
  }
</style>