---
import imageUrlBuilder from "@sanity/image-url";
import { sanityClient } from "sanity:client";

const { section } = Astro.props;

const builder = imageUrlBuilder(sanityClient);

function imageUrl(image: any) {
  if (!image?.asset) return "";

  return builder
    .image(image)
    .width(1300)
    .height(900)
    .fit("crop")
    .auto("format")
    .quality(88)
    .url();
}

let series = [];

switch (section?.selectionMode) {
  case "manual":
    series = section?.series ?? [];
    break;

  case "all":
    series = section?.allSeries ?? [];
    break;

  default:
    series = section?.featuredSeries ?? [];
}

if (section?.selectionMode !== "manual") {
  series = series.slice(0, section?.limit ?? 3);
}
---

<section class="series-section">
  <div class="container">

    <header>
      {section?.eyebrow && (
        <p class="eyebrow">{section.eyebrow}</p>
      )}

      {section?.heading && (
        <h2>{section.heading}</h2>
      )}

      {section?.accentText && (
        <p class="accent">{section.accentText}</p>
      )}

      {section?.description && (
        <p class="intro">{section.description}</p>
      )}
    </header>

    <div class="series-grid">
      {series.map((item: any) => (
        <a
          href={`/media/series/${item.slug}`}
          class="series-card"
        >
          <div class="image">
            {
              item.image?.asset && (
                <img
                  src={imageUrl(item.image)}
                  alt={item.image?.alt ?? item.title}
                  loading="lazy"
                />
              )
            }

            <div class="overlay"></div>
          </div>

          <div class="series-copy">
            <p>SERMON SERIES</p>
            <h3>{item.title}</h3>

            {item.description && (
              <div>{item.description}</div>
            )}

            <span>EXPLORE SERIES →</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .series-section {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-ivory);
  }

  header {
    max-width: 1000px;
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
  }

  .accent {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 4rem);
    font-style: italic;
  }

  .intro {
    max-width: 600px;
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 6rem);
  }

  .series-card {
    display: block;
  }

  .image {
    position: relative;
    overflow: hidden;
    background: var(--color-brand-navy);
  }

  .image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgb(3 14 28 / 8%);
  }

  .series-card:hover img {
    transform: scale(1.035);
  }

  .series-copy {
    padding-top: 1.25rem;
  }

  .series-copy > p {
    color: var(--color-brand-gold);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .series-copy h3 {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 3vw, 3.4rem);
    text-transform: uppercase;
  }

  .series-copy > div {
    margin-top: 0.8rem;
    color: var(--color-text-muted);
  }

  .series-copy span {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.68rem;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .series-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
  }
</style>