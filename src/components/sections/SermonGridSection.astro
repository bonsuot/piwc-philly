---
import imageUrlBuilder from "@sanity/image-url";
import { sanityClient } from "sanity:client";
import { resolveLink } from "../../lib/links";

const { section } = Astro.props;

const builder = imageUrlBuilder(sanityClient);

function imageUrl(image: any) {
  if (!image?.asset) return "";

  return builder
    .image(image)
    .width(1200)
    .height(750)
    .fit("crop")
    .auto("format")
    .quality(88)
    .url();
}

function getHref(link: any) {
  if (!link) return "#";

  return link.linkType === "external"
    ? link.externalUrl ?? "#"
    : link.internalPath ?? "#";
}

function formatDate(date: string) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
}

let sermons = [];

switch (section?.selectionMode) {
  case "manual":
    sermons = section?.sermons ?? [];
    break;

  case "featured":
    sermons = section?.featuredSermons ?? [];
    break;

  default:
    sermons = section?.latestSermons ?? [];
}

if (section?.selectionMode !== "manual") {
  sermons = sermons.slice(0, section?.limit ?? 3);
}
---

<section class="sermon-section">
  <div class="container">

    <div class="heading">
      <div>
        {section?.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
        {section?.heading && <h2>{section.heading}</h2>}
        {section?.accentText && <p class="accent">{section.accentText}</p>}
      </div>

      <div>
        {section?.description && <p class="description">{section.description}</p>}

        {section?.cta?.link && (
          <a class="section-link" href={resolveLink(section.cta.link)}>
            {section.cta.link.label} →
          </a>
        )}
      </div>
    </div>

    <div class="grid">
      {sermons.map((sermon: any) => (
        <a
          class="card"
          href={`/media/sermons/${sermon.slug}`}
        >
          <div class="image">
            <img
              src={imageUrl(sermon.thumbnail)}
              alt={sermon.thumbnail?.alt ?? sermon.title}
              loading="lazy"
            />
          </div>

          <div class="meta">
            <span>{sermon.series?.title ?? "Message"}</span>
            <span>{formatDate(sermon.date)}</span>
          </div>

          <h3>{sermon.title}</h3>

          <p class="speaker">
            {sermon.speakerName}
          </p>

          {sermon.scripture && (
            <p class="scripture">
              {sermon.scripture}
            </p>
          )}
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .sermon-section {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-white);
  }

  .heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 8vw, 9rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
  }

  .accent {
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 4rem);
    font-style: italic;
  }

  .heading .description {
    color: var(--color-text-muted);
  }

  .section-link {
    display: inline-block;
    margin-top: 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .image {
    overflow: hidden;
    background: var(--color-brand-navy);
  }

  .image img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .card:hover .image img {
    transform: scale(1.03);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .card h3 {
    margin-top: 0.7rem;
    font-size: clamp(1.8rem, 3vw, 3rem);
    text-transform: uppercase;
  }

  .speaker {
    margin-top: 0.5rem;
    font-family: var(--font-editorial);
    font-size: 1.1rem;
    font-style: italic;
  }

  .scripture {
    margin-top: 0.5rem;
    color: var(--color-brand-gold);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .heading {
      grid-template-columns: 1fr;
    }

    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>