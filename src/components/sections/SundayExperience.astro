---
import { resolveLink } from "../../lib/links";

interface Service {
  name?: string;
  day?: string;
  startTime?: string;
  endTime?: string;
  active?: boolean;
  description?: string;
  meetingUrl?: string;
  meetingLinkLabel?: string;
  location?: {
    name?: string;
    street?: string;
    city?: string;
    state?: string;
    zip?: string;
    mapsUrl?: string;
  };
}

interface Props {
  section: any;
}

const { section } = Astro.props;

// Preserve existing content until the ordered service list is configured.
const selectedServices: (Service | null)[] = section?.services?.length
  ? section.services
  : [section?.service];
const services = selectedServices.filter(
  (service): service is Service => Boolean(service) && service?.active !== false
);
---

<section class="sunday-section">
  <div class="container sunday-grid">
    <div class="sunday-copy">
      {section?.eyebrow && (
        <p class="eyebrow">{section.eyebrow}</p>
      )}

      {section?.heading && (
        <h2>{section.heading}</h2>
      )}

      {section?.description && (
        <p class="description">{section.description}</p>
      )}

      {section?.cta?.link && (
        <a
          href={resolveLink(section.cta.link)}
          target={section.cta.link.openInNewTab ? "_blank" : undefined}
          rel={section.cta.link.openInNewTab ? "noopener noreferrer" : undefined}
          class="visit-link"
        >
          {section.cta.link.label}
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <div class="services-grid">
    {services.map((service, index) => {
      const location = service.location;
      const address = [location?.street, location?.city, location?.state, location?.zip]
        .filter(Boolean).join(", ");
      return (
    <article class:list={["service-panel", { "service-panel--featured": index === 0 }]}>
      <h3 class="service-label">{service.name ?? "Sunday Worship"}</h3>

      <div class="service-time">
        <span>{service?.day}</span>
        <strong>{service?.startTime}</strong>
        {service.endTime && <span class="end-time">Until {service.endTime}</span>}
      </div>

      {service.description && <p class="service-description">{service.description}</p>}

      {location?.name && (
        <div class="service-location">
          <span>{location.name}</span>
          {address && <p>{address}</p>}
        </div>
      )}

      {location?.mapsUrl && (
        <a
          href={location.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="directions-link"
        >
          GET DIRECTIONS ↗
        </a>
      )}
      {service.meetingUrl && (
        <a href={service.meetingUrl} target="_blank" rel="noopener noreferrer" class="directions-link">
          {service.meetingLinkLabel || "Join Online"} ↗
        </a>
      )}
    </article>
      );
    })}
    </div>
  </div>
</section>

<style>
  .sunday-section {
    background: var(--color-brand-navy);
    color: var(--color-brand-white);
    padding-block: var(--section-space-lg);
  }

  .sunday-grid {
    display: grid;
    gap: clamp(3rem, 5vw, 5rem);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .eyebrow,
  .service-label {
    color: var(--color-brand-gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .sunday-copy h2 {
    margin-top: 1.25rem;
    max-width: 850px;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.88;
    text-transform: uppercase;
  }

  .description {
    max-width: 620px;
    margin-top: 2rem;
    color: rgb(255 255 255 / 75%);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .visit-link {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .visit-link span {
    transition: transform var(--transition-fast);
  }

  .visit-link:hover span {
    transform: translateX(5px);
  }

  .service-panel {
    min-width: 0;
    border-top: 1px solid rgb(255 255 255 / 22%);
    padding-top: 1.5rem;
  }

  .service-panel--featured {
    border-top-color: var(--color-brand-gold);
  }

  .service-description {
    margin-top: 1.5rem;
    color: rgb(255 255 255 / 75%);
  }

  .service-time {
    display: grid;
    margin-top: 2rem;
    gap: 0.4rem;
  }

  .service-time span {
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-style: italic;
  }

  .service-time strong {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .service-location {
    margin-top: 2.5rem;
  }

  .service-time .end-time {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-style: normal;
    margin-top: 0.5rem;
  }

  .service-location span {
    display: block;
    font-size: 1rem;
    font-weight: 700;
  }

  .service-location p {
    margin-top: 0.5rem;
    color: rgb(255 255 255 / 65%);
    font-size: 0.95rem;
  }

  .directions-link {
    display: inline-block;
    margin-top: 1.25rem;
    margin-right: 1.5rem;
    color: var(--color-brand-gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }
</style>
