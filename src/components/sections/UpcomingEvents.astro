---
import imageUrlBuilder from "@sanity/image-url";
import { sanityClient } from "sanity:client";

interface Props {
  section: any;
  events: any[];
}

const {
  section,
  events = [],
} = Astro.props;

const builder = imageUrlBuilder(sanityClient);

function imageUrl(image: any) {
  if (!image?.asset) return "";

  return builder
    .image(image)
    .width(1200)
    .height(1500)
    .fit("crop")
    .auto("format")
    .quality(88)
    .url();
}

function getHref(link: any) {
  if (!link) return "#";

  return link.linkType === "external"
    ? link.externalUrl ?? "#"
    : link.internalPath ?? "#";
}

function formatDate(date: string) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
  }).format(new Date(`${date}T12:00:00`));
}
---

<section class="events-section">
  <div class="container">

    <div class="events-heading">
      <div>
        {section?.eyebrow && (
          <p class="eyebrow">
            {section.eyebrow}
          </p>
        )}

        {section?.heading && (
          <h2>{section.heading}</h2>
        )}

        {section?.accentText && (
          <p class="accent">
            {section.accentText}
          </p>
        )}
      </div>

      <div class="heading-side">
        {section?.description && (
          <p>{section.description}</p>
        )}

        {section?.cta?.link && (
          <a href={getHref(section.cta.link)}>
            {section.cta.link.label}
            <span>→</span>
          </a>
        )}
      </div>
    </div>

    <div class="events-grid">
      {events.map((event) => (
        <a
          href={`/events/${event.slug}`}
          class="event-card"
        >
          <div class="event-image">
            <img
              src={imageUrl(event.image)}
              alt={event.image?.alt ?? event.title}
              loading="lazy"
            />

            <div class="event-date">
              {formatDate(event.startDate)}
            </div>
          </div>

          <div class="event-copy">
            <div class="event-meta">
              {event.startTime && (
                <span>{event.startTime}</span>
              )}

              {(event.customLocation || event.location?.name) && (
                <span>
                  {event.customLocation ?? event.location?.name}
                </span>
              )}
            </div>

            <h3>{event.title}</h3>

            {event.shortDescription && (
              <p>{event.shortDescription}</p>
            )}

            <span class="learn-more">
              EVENT DETAILS →
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .events-section {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-navy);
    color: var(--color-brand-white);
  }

  .events-heading {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 8vw, 9rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
  }

  .accent {
    margin-top: 0.4rem;
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 4.5rem);
    font-style: italic;
  }

  .heading-side p {
    color: rgb(255 255 255 / 68%);
  }

  .heading-side a {
    display: inline-flex;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .event-card {
    display: block;
  }

  .event-image {
    position: relative;
    overflow: hidden;
  }

  .event-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 700ms ease;
  }

  .event-card:hover .event-image img {
    transform: scale(1.035);
  }

  .event-date {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.7rem 0.85rem;
    background: var(--color-brand-gold);
    color: var(--color-brand-navy);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-copy {
    padding-top: 1.3rem;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: rgb(255 255 255 / 58%);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-copy h3 {
    margin-top: 0.8rem;
    font-size: clamp(2rem, 3vw, 3.5rem);
    text-transform: uppercase;
  }

  .event-copy > p {
    margin-top: 0.8rem;
    color: rgb(255 255 255 / 65%);
  }

  .learn-more {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .events-heading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .events-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-image img {
      transition: none;
    }
  }
</style>