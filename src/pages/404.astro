---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | PIWC Philadelphia"
  description="The page you're looking for could not be found."
  noIndex={true}
>
  <main>
    <section class="not-found">
      <div class="container">
        <p class="eyebrow">404</p>

        <h1>
          WE COULDN'T FIND
          <span>that page.</span>
        </h1>

        <p class="description">
          The page may have moved, or the link may no longer exist.
          We'd still love to help you find what you're looking for.
        </p>

        <div class="actions">
          <a href="/" class="primary">
            GO HOME →
          </a>

          <a href="/visit">
            PLAN YOUR VISIT →
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: 100svh;
    align-items: center;
    padding:
      10rem
      0
      var(--section-space-md);
    background: var(--color-brand-navy);
    color: white;
  }

  .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h1 {
    max-width: 1100px;
    margin-top: 1rem;
    font-size: clamp(4rem, 10vw, 9rem);
    text-transform: uppercase;
  }

  h1 span {
    display: block;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-style: italic;
    text-transform: none;
  }

  .description {
    max-width: 600px;
    margin-top: 2rem;
    color: rgb(255 255 255 / 65%);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .actions a {
    display: inline-flex;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .actions .primary {
    padding: 1rem 1.4rem;
    border: 0;
    background: var(--color-brand-gold);
    color: var(--color-brand-navy);
  }
</style>