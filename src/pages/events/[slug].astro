---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventSchema from "../../components/seo/EventSchema.astro";
import BreadcrumbSchema from "../../components/seo/BreadcrumbSchema.astro";
import { createImageUrlBuilder } from "@sanity/image-url";
import { sanityClient } from "sanity:client";
import groq from "groq";

export async function getStaticPaths() {
  const events = await sanityClient.fetch(
    groq`
      *[
        _type == "event" &&
        defined(slug.current)
      ] {
        "slug": slug.current
      }
    `
  );

  return events.map((event: any) => ({
    params: {
      slug: event.slug,
    },
  }));
}

const { slug } = Astro.params;

const event = await sanityClient.fetch(
  groq`
    *[
      _type == "event" &&
      slug.current == $slug
    ][0] {
      title,
      startDate,
      endDate,
      startTime,
      endTime,
      shortDescription,
      description,
      customLocation,
      registrationUrl,

      location-> {
        name,
        street,
        city,
        state,
        zip,
        mapsUrl
      },

      image {
        asset,
        hotspot,
        crop,
        alt
      }
    }
  `,
  { slug }
);

if (!event) {
  return Astro.redirect("/events");
}

const builder = createImageUrlBuilder(sanityClient);

const heroImage = event.image?.asset
  ? builder
      .image(event.image)
      .width(2200)
      .height(1400)
      .fit("crop")
      .auto("format")
      .quality(90)
      .url()
  : "";

function formatDate(date: string) {
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
}

const address = event.customLocation ??
  [
    event.location?.street,
    event.location?.city,
    event.location?.state,
    event.location?.zip,
  ].filter(Boolean).join(", ");
---

<BaseLayout
  title={`${event.title} | PIWC Philadelphia`}
  description={
    event.shortDescription ??
    `Learn more about ${event.title} at PIWC Philadelphia.`
  }
>
  <EventSchema
    event={event}
    imageUrl={heroImage}
    slug={slug!}
  />
  <BreadcrumbSchema
    items={[
      {
        name: "Home",
        url: "/",
      },
      {
        name: "Events",
        url: "/events",
      },
      {
        name: event.title,
        url: `/events/${slug}`,
      },
    ]}
  />
  <main>
    <section class="event-hero">
      {heroImage && (
        <img
          src={heroImage}
          alt={event.image?.alt ?? event.title}
        />
      )}

      <div class="overlay"></div>

      <div class="container hero-content">
        <p>UPCOMING EVENT</p>
        <h1>{event.title}</h1>
      </div>
    </section>

    <section class="event-details">
      <div class="container details-grid">
        <div class="event-meta">
          <div>
            <span>DATE</span>
            <strong>{formatDate(event.startDate)}</strong>
          </div>

          {event.startTime && (
            <div>
              <span>TIME</span>
              <strong>{event.startTime}</strong>
            </div>
          )}

          {address && (
            <div>
              <span>LOCATION</span>
              <strong>{address}</strong>
            </div>
          )}

          {event.location?.mapsUrl && !event.customLocation && (
            <a
              href={event.location.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              GET DIRECTIONS ↗
            </a>
          )}
        </div>

        <div class="event-copy">
          {event.shortDescription && (
            <p class="lead">{event.shortDescription}</p>
          )}

          {event.description && (
            <p>{event.description}</p>
          )}

          {event.registrationUrl && (
            <a
              href={event.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="register"
            >
              REGISTER →
            </a>
          )}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .event-hero {
    position: relative;
    display: flex;
    min-height: 85svh;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-brand-navy);
    color: white;
  }

  .event-hero img,
  .overlay {
    position: absolute;
    inset: 0;
  }

  .event-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    background:
      linear-gradient(
        0deg,
        rgb(3 14 28 / 85%) 0%,
        rgb(3 14 28 / 15%) 65%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .hero-content > p {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .hero-content h1 {
    max-width: 1200px;
    margin-top: 1rem;
    font-size: clamp(4rem, 10vw, 9rem);
    text-transform: uppercase;
  }

  .event-details {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-ivory);
  }

  .details-grid {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(4rem, 8vw, 9rem);
  }

  .event-meta {
    display: grid;
    align-content: start;
    gap: 2rem;
  }

  .event-meta div {
    display: grid;
    gap: 0.4rem;
  }

  .event-meta span {
    color: var(--color-text-muted);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .event-meta strong {
    font-size: 1.1rem;
  }

  .event-meta > a {
    width: fit-content;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .lead {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    line-height: 1.45;
  }

  .event-copy > p:not(.lead) {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }

  .register {
    display: inline-flex;
    margin-top: 2rem;
    padding: 1rem 1.35rem;
    background: var(--color-brand-gold);
    color: var(--color-brand-navy);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  @media (max-width: 800px) {
    .details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>