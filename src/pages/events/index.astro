---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageSections from "../../components/PageSections.astro";

import { createImageUrlBuilder } from "@sanity/image-url";
import { sanityClient } from "sanity:client";
import groq from "groq";

const builder = createImageUrlBuilder(sanityClient);

/*
 * Event card image
 *
 * These images are only displayed as previews, so we don't
 * need to request a 1200px / quality 88 image.
 */
function imageUrl(image: any) {
  if (!image?.asset) return "";

  return builder
    .image(image)
    .width(800)
    .height(1000)
    .fit("crop")
    .auto("format")
    .quality(80)
    .url();
}

/*
 * Fetch the Sanity Page document for /events.
 *
 * Sanity controls:
 * - Hero
 * - Page-builder sections
 * - SEO
 *
 * Astro still controls the automatic event listing below.
 */
const eventsPage = await sanityClient.fetch(
  groq`
    *[
      _type == "page" &&
      slug.current == "events" &&
      !defined(parent)
    ][0] {
      title,

      seo {
        metaTitle,
        metaDescription,
        noIndex,

        shareImage {
          asset,
          hotspot,
          crop,
          alt
        }
      },

      sections[] {
        _type,
        _key,
        ...,

        image {
          asset,
          hotspot,
          crop,
          alt,
          caption
        },

        cta {
          style,

          link {
            label,
            linkType,
            externalUrl,
            openInNewTab,
            internalPath,

            internalReference-> {
              _type,
              title,
              name,
              "slug": slug.current,

              parent-> {
                "slug": slug.current,

                parent-> {
                  "slug": slug.current
                }
              }
            }
          }
        }
      }
    }
  `
);

/*
 * Automatically fetch upcoming events.
 */
const events = await sanityClient.fetch(
  groq`
    *[
      _type == "event" &&
      defined(slug.current) &&
      startDate >= string::split(now(), "T")[0]
    ] | order(startDate asc) {
      _id,
      title,
      "slug": slug.current,
      startDate,
      startTime,
      shortDescription,
      customLocation,

      location-> {
        name
      },

      image {
        asset,
        hotspot,
        crop,
        alt
      }
    }
  `
);

/*
 * Build the SEO social image from Sanity.
 */
const seoImage =
  eventsPage?.seo?.shareImage?.asset
    ? builder
        .image(eventsPage.seo.shareImage)
        .width(1200)
        .height(630)
        .fit("crop")
        .auto("format")
        .quality(82)
        .url()
    : undefined;

function formatDate(date: string) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
}
---

<BaseLayout
  title={
    eventsPage?.seo?.metaTitle ??
    "Events | PIWC Philadelphia"
  }
  description={
    eventsPage?.seo?.metaDescription ??
    "See upcoming events at PIWC Philadelphia."
  }
  image={seoImage}
  noIndex={eventsPage?.seo?.noIndex ?? false}
>
  <main>

    <!--
      Page-builder content from Sanity.

      Your Page Hero will now render here.
    -->
    {
      eventsPage?.sections?.length > 0 && (
        <PageSections
          sections={eventsPage.sections}
        />
      )
    }

    <!--
      Upcoming events remain automatic.
    -->
    <section class="event-list">
      <div class="container">

        {
          events.length > 0 ? (
            events.map((event: any) => (
              <a
                href={`/events/${event.slug}`}
                class="event-row"
              >
                <div class="date">
                  {formatDate(event.startDate)}
                </div>

                <div>
                  <h2>{event.title}</h2>

                  <p>
                    {event.customLocation ??
                      event.location?.name ??
                      ""}
                  </p>
                </div>

                <span>VIEW EVENT →</span>

                {
                  event.image?.asset && (
                    <img
                      src={imageUrl(event.image)}
                      alt={
                        event.image?.alt ??
                        event.title
                      }
                      loading="lazy"
                      decoding="async"
                    />
                  )
                }
              </a>
            ))
          ) : (
            <div class="empty-state">
              <p class="eyebrow">
                UPCOMING EVENTS
              </p>

              <h2>
                MORE EVENTS
                <span>coming soon.</span>
              </h2>

              <p>
                Check back soon for upcoming
                gatherings and events at PIWC
                Philadelphia.
              </p>
            </div>
          )
        }

      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .event-list {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-ivory);
  }

  .event-row {
    position: relative;
    display: grid;
    grid-template-columns: 170px 1fr auto;
    gap: 2rem;
    align-items: center;
    min-height: 160px;
    border-bottom: 1px solid var(--color-border);
  }

  .date {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-row h2 {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    text-transform: uppercase;
  }

  .event-row p {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
  }

  .event-row > span {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .event-row img {
    position: absolute;
    z-index: 3;
    right: 120px;
    width: 230px;
    height: 280px;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  .event-row:hover img {
    opacity: 1;
    transform: translateY(0);
  }

  /*
   * Empty state
   */
  .empty-state {
    max-width: 760px;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .empty-state .eyebrow {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .empty-state h2 {
    margin-top: 1rem;
    font-size: clamp(2.8rem, 6vw, 6rem);
    text-transform: uppercase;
  }

  .empty-state h2 span {
    display: block;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-style: italic;
    text-transform: none;
  }

  .empty-state > p:last-child {
    max-width: 520px;
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 800px) {
    .event-row {
      grid-template-columns: 1fr;
      gap: 0.7rem;
      padding-block: 2rem;
    }

    .event-row img {
      position: static;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      opacity: 1;
      transform: none;
      grid-row: 1;
    }
  }
</style>