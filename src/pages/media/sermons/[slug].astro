---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import imageUrlBuilder from "@sanity/image-url";
import { sanityClient } from "sanity:client";
import groq from "groq";

export async function getStaticPaths() {
  const sermons = await sanityClient.fetch(
    groq`
      *[
        _type == "sermon" &&
        defined(slug.current)
      ] {
        "slug": slug.current
      }
    `
  );

  return sermons.map((sermon: any) => ({
    params: {
      slug: sermon.slug,
    },
  }));
}

const { slug } = Astro.params;

const sermon = await sanityClient.fetch(
  groq`
    *[
      _type == "sermon" &&
      slug.current == $slug
    ][0] {
      title,
      date,
      speakerName,
      scripture,
      shortDescription,
      description,
      videoUrl,
      audioUrl,

      series-> {
        title,
        "slug": slug.current
      },

      thumbnail {
        asset,
        hotspot,
        crop,
        alt
      }
    }
  `,
  { slug }
);

if (!sermon) {
  return Astro.redirect("/media/sermons");
}

const builder = imageUrlBuilder(sanityClient);

const thumbnailUrl = sermon.thumbnail?.asset
  ? builder
      .image(sermon.thumbnail)
      .width(1800)
      .height(1050)
      .fit("crop")
      .auto("format")
      .quality(90)
      .url()
  : "";

function youtubeEmbedUrl(url?: string) {
  if (!url) return null;

  try {
    const parsed = new URL(url);

    if (parsed.hostname.includes("youtu.be")) {
      return `https://www.youtube.com/embed/${parsed.pathname.slice(1)}`;
    }

    const videoId = parsed.searchParams.get("v");

    if (
      videoId &&
      parsed.hostname.includes("youtube")
    ) {
      return `https://www.youtube.com/embed/${videoId}`;
    }
  } catch {
    return null;
  }

  return null;
}

const embedUrl = youtubeEmbedUrl(sermon.videoUrl);

const formattedDate = new Intl.DateTimeFormat(
  "en-US",
  {
    month: "long",
    day: "numeric",
    year: "numeric",
  }
).format(new Date(`${sermon.date}T12:00:00`));
---

<BaseLayout
  title={`${sermon.title} | PIWC Philadelphia`}
  description={
    sermon.shortDescription ??
    `Watch ${sermon.title} from PIWC Philadelphia.`
  }
>
  <main>
    <section class="sermon-header">
      <div class="container">
        <div class="meta">
          <span>
            {sermon.series?.title ?? "Message"}
          </span>

          <span>{formattedDate}</span>
        </div>

        <h1>{sermon.title}</h1>

        <div class="details">
          <p>{sermon.speakerName}</p>

          {sermon.scripture && (
            <p>{sermon.scripture}</p>
          )}
        </div>
      </div>
    </section>

    <section class="media-section">
      <div class="container">
        {
          embedUrl ? (
            <div class="video">
              <iframe
                src={embedUrl}
                title={sermon.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          ) : thumbnailUrl ? (
            <img
              class="fallback-image"
              src={thumbnailUrl}
              alt={sermon.thumbnail?.alt ?? sermon.title}
            />
          ) : null
        }
      </div>
    </section>

    <section class="sermon-copy">
      <div class="container copy-grid">
        <div>
          <p class="label">MESSAGE</p>

          <h2>
            GROW IN
            <span>faith.</span>
          </h2>
        </div>

        <div>
          {sermon.shortDescription && (
            <p class="lead">
              {sermon.shortDescription}
            </p>
          )}

          {sermon.description && (
            <p class="description">
              {sermon.description}
            </p>
          )}

          {sermon.audioUrl && (
            <a
              href={sermon.audioUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              LISTEN TO AUDIO ↗
            </a>
          )}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sermon-header {
    padding:
      clamp(11rem, 17vw, 15rem)
      0
      var(--section-space-md);
    background: var(--color-brand-navy);
    color: white;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sermon-header h1 {
    max-width: 1200px;
    margin-top: 1.5rem;
    font-size: clamp(4rem, 10vw, 9rem);
    text-transform: uppercase;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
    color: rgb(255 255 255 / 70%);
  }

  .media-section {
    padding-block: var(--section-space-md);
    background: var(--color-brand-charcoal);
  }

  .video {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .fallback-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .sermon-copy {
    padding-block: var(--section-space-lg);
    background: var(--color-brand-ivory);
  }

  .copy-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(3rem, 8vw, 9rem);
  }

  .label {
    color: var(--color-brand-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .copy-grid h2 {
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 7rem);
    text-transform: uppercase;
  }

  .copy-grid h2 span {
    display: block;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-style: italic;
    text-transform: none;
  }

  .lead {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.5;
  }

  .description {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }

  .copy-grid a {
    display: inline-block;
    margin-top: 2rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  @media (max-width: 850px) {
    .copy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>